{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yuechengai",
  "pages_build_output_dir": "../../.wrangler/pages-dist",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zuobiao-trial",
      "database_id": "da7beafc-88aa-475a-821a-3e7ef43fa016"
    }
  ],
  "vars": {
    "PHILOSOPHY_API_BASE_URL": "https://www.xiaoxiaoapi.com",
    "PHILOSOPHY_MODEL": "gpt-5.6-sol",
    "PHILOSOPHY_REASONING_EFFORT": "xhigh",
    "TRIAL_ENABLED": "false",
    "SITE_PUBLIC_ENABLED": "true"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zuobiao-trial",
          "database_id": "da7beafc-88aa-475a-821a-3e7ef43fa016"
        }
      ],
      "vars": {
        "PHILOSOPHY_API_BASE_URL": "https://www.xiaoxiaoapi.com",
        "PHILOSOPHY_MODEL": "gpt-5.6-sol",
        "PHILOSOPHY_REASONING_EFFORT": "xhigh",
        "TRIAL_ENABLED": "false",
        "SITE_PUBLIC_ENABLED": "true"
      }
    }
  }
}
